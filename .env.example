CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token
DOCKERHUB_NAMESPACE=coloynle

# Optional, only used with docker-compose.build.yml for local image builds.
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=

# Set true to run "git pull --ff-only" for TRSS-Yunzai on container start.
AUTO_UPDATE_YUNZAI=false

# Watchtower checks the three bot containers at this interval, in seconds.
WATCHTOWER_INTERVAL=3600

# Set true to upgrade NoneBot dependencies from requirements.txt on container start.
AUTO_UPGRADE_NONEBOT=false

# Zhenxun Bot code/dependency update controls.
ZHENXUN_WEBUI_USERNAME=admin
ZHENXUN_WEBUI_PASSWORD=admin
ZHENXUN_SYNC_WEBUI_CREDENTIALS=false
AUTO_UPDATE_ZHENXUN=false
AUTO_UPGRADE_ZHENXUN=false
